        "        && page.data.rivalryIds == ids;",
        "    }",
        "",
        "    function cmsCareerIndexHeadCreateValid(accountId) {",
        "      let root = request.resource.data;",
        "      return signedIn()",
        "        && request.auth.uid == accountId",
        "        && activeDevice(root.updatedByDeviceId)",
