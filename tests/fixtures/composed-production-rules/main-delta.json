        "        && challenge.signingLockedRoles is list",
        "        && challenge.signingLockedRoles.size() == 2",
        "        && 'playerOne' in challenge.signingLockedRoles",
        "        && 'playerTwo' in challenge.signingLockedRoles;"
      ]
