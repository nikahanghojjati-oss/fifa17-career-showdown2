      "removed": [],
      "added": [
        "      }",
        "      match /chamberMenRounds/{seasonId} {",
        "        allow get: if ssjrEntitled(rivalryId);",
        "        allow list, delete: if false;",
        "        allow create: if ssjrChamberCreateValid(rivalryId, seasonId);",
        "        allow update: if ssjrChamberUpdateValid(rivalryId, seasonId);"
      ],
      "owner": "R88-CHAMBER-MEN",
