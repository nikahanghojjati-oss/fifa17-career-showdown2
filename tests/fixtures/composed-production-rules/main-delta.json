      "removed": [],
      "added": [
        "    // r88 Chamber Men (Nik 2026-11-02; js/chamberMen.js, js/chamberMenStep.js): once a season, before Roster Russian Roulette,",
        "    // a 7-round penalty shootout. The round record is rivalries/{rid}/chamberMenRounds/season_N. Each manager owns only his",
        "    // own pick string kicks[role]: two letters per round (shot, dive: L, M, R, or - when his own clock ran out). A write adds",
        "    // exactly one round to his own string and never changes what is there, and only while he is not ahead of the other",
        "    // manager (he sends round k+1 only once the other has sent round k), so nobody runs ahead and nothing is taken back.",
        "    // The other manager's string never moves. Scoring and the cylinders are worked out on both phones from the two strings;",
        "    // no lookup beyond the shared write authority, no list, no delete.",
        "    function ssjrChamberShape(root, rivalryId, seasonId) {",
        "      return root.keys().size() == 9",
        "        && root.keys().hasOnly(['schemaVersion','objectType','rivalryId','seasonNumber','kicks','revision','activeSessionId','updatedByDeviceId','updatedAt'])",
        "        && root.schemaVersion == 1",
        "        && root.objectType == 'sharedChamberMenRound'",
        "        && root.rivalryId == rivalryId",
        "        && ssjrResultsSeasonMatches(seasonId, root.seasonNumber)",
        "        && ssjrPackRoleMap(root.kicks)",
        "        && root.kicks.playerOne is string && root.kicks.playerOne.size() <= 14",
        "        && root.kicks.playerTwo is string && root.kicks.playerTwo.size() <= 14",
        "        && root.revision is int",
        "        && root.updatedAt == request.time",
        "        && ssjrWriteAuthorityValid(rivalryId, root.updatedByDeviceId, root.activeSessionId);",
        "    }",
        "    function ssjrChamberCreateValid(rivalryId, seasonId) {",
        "      let after = request.resource.data;",
        "      let role = ssjrActorRole(rivalryId);",
        "      return ssjrChamberShape(after, rivalryId, seasonId)",
        "        && after.revision == 1",
        "        && after.kicks[role].matches('[LMR-]{2}')",
        "        && after.kicks[ssjrPackOther(role)] == '';",
        "    }",
        "    function ssjrChamberUpdateValid(rivalryId, seasonId) {",
        "      let before = resource.data;",
        "      let after = request.resource.data;",
        "      let role = ssjrActorRole(rivalryId);",
        "      let other = ssjrPackOther(role);",
        "      return ssjrChamberShape(after, rivalryId, seasonId)",
        "        && after.seasonNumber == before.seasonNumber",
        "        && after.revision == before.revision + 1",
        "        && after.kicks[other] == before.kicks[other]",
        "        && before.kicks[role].size() <= before.kicks[other].size()",
        "        && after.kicks[role].matches(before.kicks[role] + '[LMR-]{2}');",
        "    }"
      ],
      "owner": "R88-CHAMBER-MEN",
      "why": "r88 Chamber Men (Nik 2026-11-02): per-season shootout round record rivalries/{rid}/chamberMenRounds/season_N; each manager appends one round to his own pick string, never ahead of the other."
    },
    {
      "mainLine": 3314,
