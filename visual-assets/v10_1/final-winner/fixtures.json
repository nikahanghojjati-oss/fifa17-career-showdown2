  "routes": {
    "sharedFinalResult": {
      "opens": "#seasonEntry with #seasonReviewPanel",
      "productBinding": "js/productionSharedSeasonResultsRoute.js -> js/productionSharedFinalReconciliation.js + js/productionSharedTerminalClose.js",
      "note": "No standalone Final Winner route exists on main."
    },
    "completedShowdown": {
      "opens": "#dashboard",
      "productBinding": "js/seasonEngine.js handleSeasonSummaryAction() and js/screens.js resolveCanonicalShowdownRoute()",
      "trigger": "#nextSeasonAction = VIEW COMPLETED SHOWDOWN"
    },
    "viewLegacy": {
      "opens": "legacy",
      "productBinding": "js/showdownUI.js completion hub -> openOptionalModule('legacy')"
    },
    "trophyRoom": {
      "opens": "trophyRoom",
      "productBinding": "js/showdownUI.js completion hub -> openOptionalModule('trophyRoom')"
    },
    "rivalryStatistics": {
      "opens": "statistics",
      "productBinding": "js/showdownUI.js completion hub -> openOptionalModule('statistics')"
    },
    "newShowdown": {
      "opens": "#createShowdown",
      "productBinding": "js/showdownUI.js completion hub -> navigateTo('createShowdown')"
    },
    "mainMenu": {
      "opens": "#mainMenu",
      "productBinding": "js/showdownUI.js completion hub / centralized smart Back"
    },
    "terminalClose": {
      "action": "CLOSE SHARED SHOWDOWN",
      "productBinding": "js/productionSharedTerminalClose.js ptcClose()",
      "retry": "RETRY SAME TERMINAL CLOSE"
    }
  }
