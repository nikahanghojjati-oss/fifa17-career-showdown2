      "productBinding": "js/showdownUI.js completion hub -> openOptionalModule('trophyRoom')"
    },
    "rivalryStatistics": {
      "opens": "statistics",
      "productBinding": "js/showdownUI.js completion hub -> openOptionalModule('statistics')"
    },
    "newShowdown": {
      "opens": "#createShowdown",
      "productBinding": "js/showdownUI.js completion hub -> navigateTo('createShowdown')"
    },
    "mainMenu": {
      "opens": "#mainMenu",
      "productBinding": "js/showdownUI.js completion hub / centralized smart Back"
    },
    "terminalClose": {
      "action": "CLOSE SHARED SHOWDOWN",
