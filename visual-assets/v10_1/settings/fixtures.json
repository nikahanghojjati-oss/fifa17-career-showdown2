  "routes": {
    "open": {
      "from": [
        "#settingsButton",
        "#onlinePlayerIdentityBadge when identity is ready"
      ],
      "productBinding": "js/optionalModules.js openOptionalModule('settings') -> js/settings.js openSettings()"
    },
    "close": {
      "triggers": [
        "#settingsClose",
        "DONE",
        "Escape",
        "backdrop pointer-down"
      ],
      "destination": "restore the underlying screen and opener focus",
      "productBinding": "js/settings.js closeSettings()"
    },
    "openHistoryBackup": {
      "action": "OPEN HISTORY & BACKUP",
      "destination": "legacy",
      "productBinding": "js/settings.js openSettingsDataManagement() -> openOptionalModule('legacy')"
    },
    "deleteCurrentShowdown": {
      "action": "DELETE CURRENT SHOWDOWN",
      "confirmRequired": true,
      "successDestination": "mainMenu",
      "productBinding": "js/settings.js deleteSettingsCurrentShowdown() -> provider abandon -> local clear -> mainMenu"
    },
    "updateApplication": {
      "action": "UPDATE TO LATEST VERSION / APPLY READY UPDATE",
      "destination": "stay in Settings until update activation/reload",
      "productBinding": "js/settings.js handleSettingsOfflineUpdate() -> js/offlineApp.js"
    },
    "accountActions": {
      "productBinding": "js/onlinePlayerIdentity.js renderOnlineSettings()",
      "actions": [
        "SIGN IN WITH GOOGLE",
        "DANIEL · PLAYER ONE",
        "NIK · PLAYER TWO",
        "TRY AGAIN",
        "FORGET THIS DEVICE"
      ]
    }
