{
  "schema": "showdown-gate-coverage/v1",
  "purpose": "Maps every step of the 16 current gates (all jobs of Validate POS20, with its proof matrix expanded per group, and Validate Gameplay Fast) to the Showdown Gate step that runs it. tests/contracts/showdown-gate-coverage-contracts.cjs fails if an old step is unmapped, a mapping is stale, or a mapped Showdown Gate step does not run the old command.",
  "gateWorkflow": ".github/workflows/showdown-gate.yml",
  "oldWorkflows": [
    ".github/workflows/validate-pos10.yml",
    ".github/workflows/validate-gameplay-fast.yml"
  ],
  "modes": {
    "checkout": "Target is actions/checkout of the same major version pinned to the exact PR head or push sha.",
    "setup": "Target uses the same action with identical with: values (node-version, distribution, java-version).",
    "exact": "Every command line of the old run block appears verbatim in the target run block, and every old step env entry is identical.",
    "contracts-all": "Old routed contract subset; target runs npm run test:contracts, which must be run-selected-product-contracts.cjs --all.",
    "proof-groups": "Old proof matrix; one target per POS10 proof group runs the identical proof-runner command with POS20_PROOF_GROUP set to that group and the full routed proof list.",
    "route": "Old selector; targets compute the changed files and call the unchanged POS20 router CLI the same way (verified functionally).",
    "seal": "Old exact-head seal; target is the Showdown Gate seal (needs every lane, never skipped unless the run is cancelled).",
    "cache": "Old emulator cache; target caches ~/.cache/firebase/emulators.",
    "artifact": "Target uploads with the same action and identical with: values (extra overwrite allowed)."
  },
  "oldJobNames": {
    ".github/workflows/validate-pos10.yml#route": "POS20 exact selector",
    ".github/workflows/validate-pos10.yml#benchmark": "POS20 cognitive benchmark",
