  "artifactRules": [
    {
      "id": "shared-setup",
      "patterns": [
        "^js/sharedShowdown",
        "^tests/(?:contracts|browser|firebase)/shared-showdown",
        "^tests/contracts/ssjr-production",
        "^scripts/(?:record|validate)-ssjr",
        "^SHARED_SHOWDOWN_JOURNEY_READINESS\\.json$",
        "^SSJR_"
      ],
      "invariants": [
        "SHARED_SETUP"
      ]
    },
    {
      "id": "remote-joining",
      "patterns": [
        "^js/stage5",
        "^tests/(?:contracts|browser|firebase)/stage5",
        "remote-joining",
        "private-session"
      ],
      "invariants": [
        "REMOTE_JOINING"
      ]
    },
    {
      "id": "pairing-rivalry",
      "patterns": [
        "^js/(?:pairing|connected|stage4)",
        "^tests/(?:contracts|browser|firebase)/(?:stage3-private-pairing|pairing|stage4)"
      ],
      "invariants": [
        "PAIRING_RIVALRY"
      ]
    },
    {
      "id": "identity-cloud",
      "patterns": [
        "^js/(?:firebase|cloudSync|remoteData|managerIdentity)",
        "^firebase",
        "^firestore",
        "^\\.firebaserc$",
        "^scripts/build-production-firestore-rules\\.mjs$",
        "^tests/(?:contracts|firebase)/(?:cloud|remote-data|production-app-check|spark|firebase-permanent)"
      ],
      "invariants": [
        "IDENTITY_CLOUD_FOUNDATION"
      ]
    },
    {
      "id": "storage-recovery",
      "patterns": [
        "^js/(?:storage|backup|import|restore|save)",
        "^tests/(?:contracts|browser)/(?:backup|import|restore|save-library|multi-save)",
        "storage-observation"
      ],
      "invariants": [
        "STORAGE_RECOVERY"
      ]
    },
    {
      "id": "season-review",
      "patterns": [
        "^js/seasonEngine\\.js$",
        "season-review"
      ],
      "invariants": [
        "SEASON_REVIEW"
      ]
    },
    {
      "id": "statistics",
      "patterns": [
        "^js/analytics\\.js$",
        "statistics",
        "identity-safe-career-analytics"
      ],
      "invariants": [
        "STATISTICS_ANALYTICS"
      ]
    },
    {
      "id": "visual-general",
      "patterns": [
        "^css/",
        "^assets/",
        "^js/footballVisuals\\.js$",
        "^tests/(?:contracts|browser)/(?:final-polish|licensed-football-visuals|home-visual|loading-visual|football-visual)"
      ],
      "invariants": [
        "VISUAL_PRESENTATION"
      ]
    },
    {
      "id": "core-runtime",
      "patterns": [
        "^index\\.html$",
        "^js/(?:app|showdown|screens|optionalModules|offlineApp|dataEngine|diagnostics)\\.js$",
        "^tests/(?:contracts|browser)/(?:stability|static-app|release-shell|offline|final-release|runtime-error-boundary)"
      ],
      "invariants": [
        "CORE_RUNTIME_RELEASE"
      ]
    },
    {
      "id": "home-inline",
      "patterns": [
        "^js/menuExperience\\.js$",
        "^css/app\\.css$",
        "^index\\.html$",
        "^THIRD_PARTY_NOTICES\\.md$"
      ],
      "invariants": [
        "VISUAL_PRESENTATION"
      ],
      "proofBundles": [
        "INLINE_HOME"
      ]
    },
    {
      "id": "league-inline",
      "patterns": [
        "^js/(?:leagueWheel|clubAssignment)\\.js$",
        "^data/leagues\\.js$"
      ],
      "invariants": [
        "SHARED_SETUP"
      ],
      "proofBundles": [
        "INLINE_LEAGUE"
      ]
    },
    {
      "id": "settings-inline",
      "patterns": [
        "^js/settings\\.js$",
        "^css/settings\\.css$",
        "^css/offline\\.css$",
        "^js/storage\\.js$",
        "^js/offlineApp\\.js$"
      ],
      "invariants": [
        "CORE_RUNTIME_RELEASE",
        "VISUAL_PRESENTATION",
        "STORAGE_RECOVERY"
      ],
      "proofBundles": [
        "INLINE_SETTINGS"
      ]
    },
    {
      "id": "transfer-inline",
      "patterns": [
        "^js/(?:transferChallenge|transferSelector)\\.js$",
        "^css/transfer\\.css$",
        "^data/transferOptions\\.js$"
      ],
      "invariants": [
        "CORE_RUNTIME_RELEASE",
        "VISUAL_PRESENTATION"
      ],
      "proofBundles": [
        "INLINE_TRANSFER"
      ]
    },
    {
      "id": "v1-visual-inline",
      "patterns": [
        "^css/visual-fidelity-r3\\.css$",
        "^assets/marco-reus-2015-cc-by\\.webp$",
        "^assets/loading/[^/]+\\.webp$",
        "^css/app\\.css$",
        "^index\\.html$",
        "^js/app\\.js$",
        "^js/menuExperience\\.js$"
      ],
      "invariants": [
        "VISUAL_PRESENTATION"
      ],
      "proofBundles": [
        "INLINE_V1_VISUAL"
      ]
    },
    {
      "id": "app-css-inline-consumers",
      "patterns": [
        "^css/app\\.css$"
      ],
      "invariants": [],
      "proofBundles": [
        "INLINE_SETTINGS",
        "INLINE_TRANSFER"
      ]
    }
